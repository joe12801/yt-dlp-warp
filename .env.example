# 复制为 .env 后按需修改。命令行参数始终优先于这里的值。
# .env 已加入 .gitignore，切勿提交包含 cookie / token 的文件。

# ---- 网络：WARP SOCKS5 ----
# 默认走 Cloudflare WARP 官方客户端的 proxy 模式（只监听 127.0.0.1，不改全局路由）。
# 家宽等干净出口可以改成空值并用 --no-proxy 直连。
YTWARP_PROXY=socks5://127.0.0.1:40000

# ---- Cookie：默认完全不需要 ----
# 公开视频 + WARP 生效时留空即可。只有遇到登录墙 / 年龄限制 / 会员内容才填。
# 文件必须是 Netscape cookies.txt，由 scripts/cookie-editor-to-netscape.py 生成。
# 主凭证文件全程只读：ytwarp.py 会复制临时快照给 yt-dlp，不会回写、不会删除。
YTWARP_COOKIES=

# 不推荐：让 yt-dlp 直接读浏览器 profile。Chrome 127+ 的 App-Bound Encryption
# 下通常无效，且可能锁定/改写登录 cookie。仅在明确知道后果时启用。
# 例：chrome 或 chrome:Profile 12
YTWARP_COOKIES_FROM_BROWSER=

# ---- 下载偏好 ----
YTWARP_FORMAT=bv*+ba/b
# mkv 能容纳 VP9/AV1 + Opus；需要 mp4 容器时改成 mp4
YTWARP_MERGE=mkv
YTWARP_OUTPUT=downloads/%(title).200B [%(id)s].%(ext)s
YTWARP_SUB_LANGS=zh-Hans,zh-Hant,en,ja,ko
YTWARP_RETRIES=5
YTWARP_LIMIT_RATE=

# auto / node / deno / none：YouTube JS challenge 运行时
YTWARP_JS_RUNTIME=auto
# ffmpeg 所在目录，留空则从 PATH 查找
YTWARP_FFMPEG=
# 额外透传给 yt-dlp 的参数，例如 --write-info-json --sponsorblock-remove all
YTWARP_EXTRA_ARGS=

# 保留环境注入的 NODE_OPTIONS（默认会清除，沙箱 shim 会破坏 yt-dlp-ejs）
YTWARP_KEEP_NODE_OPTIONS=
